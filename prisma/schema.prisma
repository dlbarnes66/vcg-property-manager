// VCG Property Manager — "DoorLoop Lite" with HUD-VASH support.
// All money is stored as integer cents to avoid floating-point errors.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PropertyType {
  MULTIFAMILY
  SINGLE_FAMILY
  DUPLEX
  OTHER
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum Party {
  TENANT
  HOUSING_AUTHORITY
}

enum ChargeType {
  RENT
  LATE_FEE
  SECURITY_DEPOSIT
  UTILITY
  DAMAGE
  OTHER
}

enum PaymentMethod {
  ACH
  CHECK
  CASH
  CARD
  MONEY_ORDER
  OTHER
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}

enum MaintenanceStatus {
  OPEN
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InspectionType {
  HQS_INITIAL
  HQS_ANNUAL
  NSPIRE
  REINSPECTION
  MOVE_IN
  MOVE_OUT
  INTERNAL
}

enum InspectionResult {
  PENDING
  PASS
  FAIL
  INCONCLUSIVE
}

enum OnlinePaymentStatus {
  PENDING // checkout opened, not finished
  PROCESSING // ACH submitted, waiting for the bank (typically 4 business days)
  SUCCEEDED // posted to the ledger
  FAILED // bank transfer failed or was returned
  EXPIRED // checkout abandoned
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum Recurrence {
  NONE
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum EventType {
  MEETING
  SHOWING
  APPOINTMENT
  INSPECTION
  REMINDER
  OTHER
}

enum MessageChannel {
  EMAIL
  SMS
  CALL // logged only
  OTHER // logged only (in person, letter, portal, ...)
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  RECEIVED
  LOGGED
}

enum DocumentCategory {
  LEASE
  HAP_CONTRACT
  INSPECTION
  RECEIPT
  PHOTO
  ID
  NOTICE
  OTHER
}

model Property {
  id            String       @id @default(cuid())
  name          String
  type          PropertyType @default(MULTIFAMILY)
  street        String
  city          String
  state         String
  zip           String
  purchasePrice Int? // cents
  purchaseDate  DateTime?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  units        Unit[]
  documents    Document[]
  noteEntries  Note[]
  tasks        Task[]
  events       CalendarEvent[]
  messages     Message[]
  bills        Bill[]
  journalLines JournalLine[]
}

model Unit {
  id         String   @id @default(cuid())
  propertyId String
  label      String // "Unit 2B", "Main house"
  bedrooms   Int      @default(1)
  bathrooms  Float    @default(1)
  sqft       Int?
  marketRent Int? // cents
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property    Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leases      Lease[]
  maintenance MaintenanceRequest[]
  inspections Inspection[]
  documents   Document[]
  noteEntries Note[]
  tasks       Task[]
  events      CalendarEvent[]
  listings    Listing[]

  @@unique([propertyId, label])
}

model Tenant {
  id                    String    @id @default(cuid())
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  isVeteran             Boolean   @default(true)
  caseManagerName       String? // VA / HUD-VASH case manager
  caseManagerPhone      String?
  caseManagerEmail      String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?
  // Tenant portal
  portalEnabled         Boolean   @default(false)
  portalInvitedAt       DateTime?
  clerkUserId           String?   @unique // set the first time the tenant signs in to the portal
  stripeCustomerId      String?   @unique
  // Communications
  smsConsent            Boolean   @default(false) // tenant agreed to receive texts (required before the app texts them)
  smsConsentAt          DateTime?
  emailOptOut           Boolean   @default(false) // excluded from announcements; direct messages still allowed
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  leases              Lease[]
  documents           Document[]
  maintenanceRequests MaintenanceRequest[]
  onlinePayments      OnlinePayment[]
  noteEntries         Note[]
  tasks               Task[]
  events              CalendarEvent[]
  messages            Message[]
  applications        Application[]
}

// Public Housing Agency that pays the HAP (housing assistance payment) portion.
model HousingAuthority {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  portalUrl   String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leases      Lease[]
  noteEntries Note[]
  tasks       Task[]
  messages    Message[]
}

model Lease {
  id                 String      @id @default(cuid())
  unitId             String
  tenantId           String
  status             LeaseStatus @default(ACTIVE)
  startDate          DateTime
  endDate            DateTime?
  // Rent split. contractRent = tenantPortion + hapAmount for voucher leases.
  contractRent       Int // cents, total rent to owner
  tenantPortion      Int // cents, what the tenant pays
  hapAmount          Int         @default(0) // cents, what the housing authority pays
  dueDay             Int         @default(1)
  securityDeposit    Int         @default(0) // cents
  lateFeeAmount      Int         @default(0) // cents, flat fee on tenant portion only
  lateFeeGraceDays   Int         @default(5)
  // HUD-VASH / voucher details
  housingAuthorityId String?
  voucherNumber      String?
  hapContractStart   DateTime?
  nextRecertDate     DateTime? // annual income recertification
  moveInDate         DateTime?
  moveOutDate        DateTime?
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  unit             Unit              @relation(fields: [unitId], references: [id], onDelete: Restrict)
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  housingAuthority HousingAuthority? @relation(fields: [housingAuthorityId], references: [id], onDelete: SetNull)
  charges          Charge[]
  payments         Payment[]
  documents        Document[]
  onlinePayments   OnlinePayment[]
  noteEntries      Note[]
  tasks            Task[]
  events           CalendarEvent[]
  messages         Message[]

  @@index([status])
}

// Anything owed on a lease. Rent is split into two charges each month (tenant + housing authority).
model Charge {
  id          String     @id @default(cuid())
  leaseId     String
  type        ChargeType
  party       Party      @default(TENANT)
  amount      Int // cents
  dueDate     DateTime
  period      String? // "2026-10" for monthly rent / late fee; enforces one per month
  description String?
  createdAt   DateTime   @default(now())

  lease        Lease         @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry?

  @@unique([leaseId, type, party, period])
  @@index([dueDate])
}

model Payment {
  id                    String        @id @default(cuid())
  leaseId               String
  party                 Party         @default(TENANT)
  amount                Int // cents
  paidOn                DateTime
  method                PaymentMethod @default(ACH)
  reference             String? // check #, ACH trace, PHA remittance #
  notes                 String?
  stripePaymentIntentId String?       @unique // set for online payments; prevents double-posting
  createdAt             DateTime      @default(now())

  lease         Lease          @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  onlinePayment OnlinePayment?
  journalEntry  JournalEntry?

  @@index([paidOn])
}

model Vendor {
  id        String   @id @default(cuid())
  name      String
  trade     String? // plumbing, HVAC, electrical...
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests    MaintenanceRequest[]
  noteEntries Note[]
  tasks       Task[]
  messages    Message[]
  bills       Bill[]
}

model MaintenanceRequest {
  id                  String              @id @default(cuid())
  unitId              String
  vendorId            String?
  title               String
  description         String?
  priority            MaintenancePriority @default(NORMAL)
  status              MaintenanceStatus   @default(OPEN)
  reportedOn          DateTime            @default(now())
  scheduledOn         DateTime?
  completedOn         DateTime?
  cost                Int? // cents
  submittedByTenantId String? // set when the tenant submitted it through the portal
  permissionToEnter   Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  unit        Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  vendor      Vendor?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  submittedBy Tenant?    @relation(fields: [submittedByTenantId], references: [id], onDelete: SetNull)
  documents   Document[]
  noteEntries Note[]
  tasks       Task[]
  messages    Message[]
  bills       Bill[]

  @@index([status])
}

model Inspection {
  id            String           @id @default(cuid())
  unitId        String
  type          InspectionType
  scheduledDate DateTime
  completedDate DateTime?
  result        InspectionResult @default(PENDING)
  inspector     String?
  deficiencies  String?
  cureByDate    DateTime? // deadline to fix failed items before HAP abatement
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  unit      Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  documents Document[]
}

model Document {
  id               String           @id @default(cuid())
  name             String
  category         DocumentCategory @default(OTHER)
  storageKey       String           @unique
  mimeType         String
  size             Int
  sharedWithTenant Boolean          @default(false) // visible in the tenant portal
  uploadedByTenant Boolean          @default(false)
  propertyId       String?
  unitId           String?
  tenantId         String?
  leaseId          String?
  maintenanceId    String?
  inspectionId     String?
  listingId        String?
  applicationId    String?
  createdAt        DateTime         @default(now())

  property    Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unit        Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)
  tenant      Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  lease       Lease?              @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  maintenance MaintenanceRequest? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)
  inspection  Inspection?         @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  listing     Listing?            @relation(fields: [listingId], references: [id], onDelete: SetNull)
  application Application?        @relation(fields: [applicationId], references: [id], onDelete: SetNull)
}

// A rent payment a tenant started in the portal. Becomes a ledger Payment only once Stripe confirms the money.
model OnlinePayment {
  id                String              @id @default(cuid())
  leaseId           String
  tenantId          String
  amount            Int // cents
  status            OnlinePaymentStatus @default(PENDING)
  checkoutSessionId String              @unique
  paymentIntentId   String?             @unique
  failureReason     String?
  paymentId         String?             @unique
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  lease   Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([leaseId, status])
}

// ---------------------------------------------------------------------------------------------
// Phase 1 operations: notes, tasks, calendar, communications
// ---------------------------------------------------------------------------------------------

// A note attached to exactly one record (property, unit, tenant, lease, work order, vendor, or PHA).
model Note {
  id                 String   @id @default(cuid())
  body               String
  pinned             Boolean  @default(false)
  authorEmail        String?
  propertyId         String?
  unitId             String?
  tenantId           String?
  leaseId            String?
  maintenanceId      String?
  vendorId           String?
  housingAuthorityId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  property         Property?           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit             Unit?               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenant           Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lease            Lease?              @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  maintenance      MaintenanceRequest? @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  vendor           Vendor?             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  housingAuthority HousingAuthority?   @relation(fields: [housingAuthorityId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model Task {
  id                 String       @id @default(cuid())
  title              String
  description        String?
  status             TaskStatus   @default(TODO)
  priority           TaskPriority @default(NORMAL)
  dueDate            DateTime?
  completedAt        DateTime?
  recurrence         Recurrence   @default(NONE) // completing a recurring task creates the next one
  assigneeEmail      String?
  createdByEmail     String?
  propertyId         String?
  unitId             String?
  tenantId           String?
  leaseId            String?
  maintenanceId      String?
  vendorId           String?
  housingAuthorityId String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  property         Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unit             Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)
  tenant           Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  lease            Lease?              @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  maintenance      MaintenanceRequest? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)
  vendor           Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  housingAuthority HousingAuthority?   @relation(fields: [housingAuthorityId], references: [id], onDelete: SetNull)

  @@index([status, dueDate])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  type        EventType @default(OTHER)
  start       DateTime // all-day events: UTC midnight of the day
  end         DateTime?
  allDay      Boolean   @default(false)
  location    String?
  propertyId  String?
  unitId      String?
  tenantId    String?
  leaseId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  unit     Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  tenant   Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  lease    Lease?    @relation(fields: [leaseId], references: [id], onDelete: SetNull)

  @@index([start])
}

// One email, text, or logged call to/from one person. Announcements create one row per recipient (same batchId).
model Message {
  id                 String           @id @default(cuid())
  channel            MessageChannel
  direction          MessageDirection @default(OUTBOUND)
  status             MessageStatus    @default(QUEUED)
  toAddress          String? // email address or E.164 phone
  fromAddress        String?
  subject            String?
  body               String
  error              String?
  providerMessageId  String?          @unique // SendGrid X-Message-Id or Twilio SID
  batchId            String?
  sentByEmail        String?
  // who it's with
  tenantId           String?
  vendorId           String?
  housingAuthorityId String?
  // what it's about
  propertyId         String?
  leaseId            String?
  maintenanceId      String?
  readAt             DateTime? // inbound only: when you opened it
  sentAt             DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tenant           Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  vendor           Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  housingAuthority HousingAuthority?   @relation(fields: [housingAuthorityId], references: [id], onDelete: SetNull)
  property         Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  lease            Lease?              @relation(fields: [leaseId], references: [id], onDelete: SetNull)
  maintenance      MaintenanceRequest? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([batchId])
}

model MessageTemplate {
  id        String         @id @default(cuid())
  name      String         @unique
  channel   MessageChannel // EMAIL or SMS
  subject   String?
  body      String // supports {{firstName}}, {{lastName}}, {{property}}, {{unit}}, {{balance}}, {{rent}}, {{dueDate}}
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

// ---------------------------------------------------------------------------------------------
// Phase 2: leasing
// ---------------------------------------------------------------------------------------------

enum ListingStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  NEW
  SCREENING
  APPROVED
  DENIED
  WITHDRAWN
  CONVERTED // became a tenant
}

// A vacant unit advertised on the public /rentals page.
model Listing {
  id                String        @id @default(cuid())
  unitId            String
  slug              String        @unique // public link: /apply/<slug>
  status            ListingStatus @default(DRAFT)
  headline          String
  description       String?
  rent              Int // cents, advertised contract rent
  deposit           Int           @default(0) // cents
  availableDate     DateTime?
  acceptsVouchers   Boolean       @default(true)
  petPolicy         String?
  utilitiesIncluded String?
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  unit         Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  applications Application[]
  documents    Document[] // photos (shown publicly only while the listing is published)

  @@index([status])
}

model Application {
  id                   String            @id @default(cuid())
  listingId            String
  status               ApplicationStatus @default(NEW)
  firstName            String
  lastName             String
  email                String
  phone                String
  isVeteran            Boolean?
  householdSize        Int               @default(1)
  desiredMoveIn        DateTime?
  currentAddress       String?
  currentLandlord      String?
  currentLandlordPhone String?
  monthlyIncome        Int? // cents
  incomeSource         String?
  employer             String?
  hasVoucher           Boolean           @default(false)
  voucherType          String? // HUD-VASH, HCV, other
  housingAuthorityName String?
  caseManagerName      String?
  caseManagerPhone     String?
  caseManagerEmail     String?
  pets                 String?
  additionalInfo       String?
  consentAt            DateTime // applicant agreed the information is accurate and may be verified
  // Screening checklist (manual)
  idVerified           Boolean           @default(false)
  incomeVerified       Boolean           @default(false)
  voucherVerified      Boolean           @default(false)
  referenceChecked     Boolean           @default(false)
  backgroundReviewed   Boolean           @default(false)
  screeningNotes       String?
  decisionReason       String?
  decidedAt            DateTime?
  decidedByEmail       String?
  tenantId             String? // set when converted
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  listing   Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tenant    Tenant?    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  documents Document[]

  @@index([status, createdAt])
  @@index([email])
}

// ---------------------------------------------------------------------------------------------
// Phase 2: accounting (double-entry). Amounts in cents. Every entry's debits equal its credits.
// ---------------------------------------------------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum EntrySource {
  MANUAL
  CHARGE // posted automatically from a lease charge
  PAYMENT // posted automatically from a payment received
  BILL
  BILL_PAYMENT
  BANK // created while categorizing an imported bank transaction
}

enum BillStatus {
  OPEN
  PAID
  VOID
}

enum BankTxnStatus {
  UNMATCHED
  MATCHED
  EXCLUDED
}

model Account {
  id          String      @id @default(cuid())
  code        String      @unique // "1000"
  name        String
  type        AccountType
  isBank      Boolean     @default(false) // can import statements / receive payments
  isSystem    Boolean     @default(false) // used by automatic posting; can't be deleted
  active      Boolean     @default(true)
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  lines            JournalLine[]
  billsExpensed    Bill[]            @relation("BillExpenseAccount")
  billPayments     BillPayment[]
  bankTransactions BankTransaction[]
  reconciliations  Reconciliation[]
}

model JournalEntry {
  id             String      @id @default(cuid())
  date           DateTime
  memo           String?
  source         EntrySource @default(MANUAL)
  chargeId       String?     @unique
  paymentId      String?     @unique
  billId         String?     @unique
  billPaymentId  String?     @unique
  createdByEmail String?
  createdAt      DateTime    @default(now())

  lines       JournalLine[]
  charge      Charge?       @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  payment     Payment?      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill        Bill?         @relation(fields: [billId], references: [id], onDelete: Cascade)
  billPayment BillPayment?  @relation(fields: [billPaymentId], references: [id], onDelete: Cascade)

  @@index([date])
}

model JournalLine {
  id               String    @id @default(cuid())
  entryId          String
  accountId        String
  debit            Int       @default(0)
  credit           Int       @default(0)
  propertyId       String?
  memo             String?
  clearedAt        DateTime? // matched to a bank transaction or marked cleared
  reconciliationId String?
  createdAt        DateTime  @default(now())

  entry           JournalEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account         Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  property        Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  reconciliation  Reconciliation?  @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)
  bankTransaction BankTransaction?

  @@index([accountId])
  @@index([propertyId])
}

model Bill {
  id               String     @id @default(cuid())
  vendorId         String?
  payee            String? // when not a saved vendor
  propertyId       String?
  maintenanceId    String?
  expenseAccountId String
  billDate         DateTime
  dueDate          DateTime?
  amount           Int // cents
  description      String
  reference        String? // invoice #
  status           BillStatus @default(OPEN)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  vendor         Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  property       Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  maintenance    MaintenanceRequest? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)
  expenseAccount Account             @relation("BillExpenseAccount", fields: [expenseAccountId], references: [id], onDelete: Restrict)
  payments       BillPayment[]
  journalEntry   JournalEntry?

  @@index([status, dueDate])
}

model BillPayment {
  id            String        @id @default(cuid())
  billId        String
  bankAccountId String
  date          DateTime
  amount        Int
  method        PaymentMethod @default(ACH)
  reference     String?
  createdAt     DateTime      @default(now())

  bill         Bill          @relation(fields: [billId], references: [id], onDelete: Cascade)
  bankAccount  Account       @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry?
}

// A line from an imported bank statement (CSV). Positive = money in, negative = money out.
model BankTransaction {
  id            String        @id @default(cuid())
  accountId     String
  date          DateTime
  description   String
  amount        Int
  hash          String        @unique // dedupe re-imports of the same statement
  status        BankTxnStatus @default(UNMATCHED)
  matchedLineId String?       @unique
  importBatch   String
  createdAt     DateTime      @default(now())

  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  matchedLine JournalLine? @relation(fields: [matchedLineId], references: [id], onDelete: SetNull)

  @@index([accountId, status, date])
}

model Reconciliation {
  id               String   @id @default(cuid())
  accountId        String
  statementDate    DateTime
  statementBalance Int
  createdByEmail   String?
  createdAt        DateTime @default(now())

  account Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lines   JournalLine[]
}
