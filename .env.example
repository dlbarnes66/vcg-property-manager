# Postgres (local, Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vcg_pm?schema=public"

# Clerk — create a NEW application at dashboard.clerk.com (keep it separate from Grant Scout Pro)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Admin emails (comma-separated): full access to everything. Required — if blank, nobody is an admin.
# Tenants are NOT listed here; they get access by being invited from their tenant page.
ALLOWED_EMAILS="dlbarnes@vcgnow.com"

# Document storage. Leave R2_* blank to store files on local disk in ./storage (fine for dev).
# For production use Cloudflare R2 (or any S3-compatible bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Public URL of the app (used in invitation emails and Stripe return links). Optional locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Shown in the resident portal footer (optional)
MANAGER_PHONE=
MANAGER_EMAIL=

# Stripe — online rent payments in the resident portal. Leave blank to hide the Pay button.
# dashboard.stripe.com → Developers → API keys (use test keys sk_test_... while building)
STRIPE_SECRET_KEY=
# From the webhook endpoint you create (or from `stripe listen` locally): whsec_...
STRIPE_WEBHOOK_SECRET=
# ACH bank transfer only by default (0.8%, max $5). Set to true to also accept cards (~2.9% + 30¢).
STRIPE_ALLOW_CARDS=false
