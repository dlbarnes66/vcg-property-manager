# Postgres (local, Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vcg_pm?schema=public"

# Clerk — create a NEW application at dashboard.clerk.com (keep it separate from Grant Scout Pro)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Only these emails can use the app (comma-separated). Leave blank to allow any signed-in user.
ALLOWED_EMAILS="dlbarnes@vcgnow.com"

# Document storage. Leave R2_* blank to store files on local disk in ./storage (fine for dev).
# For production use Cloudflare R2 (or any S3-compatible bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
